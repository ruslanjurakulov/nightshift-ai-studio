# Nightshift customer e-mail worker — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.email (mode 600) from GitHub on every deploy while the
# GitHub repository variable NIGHTSHIFT_EMAIL_WORKER is `on`, and
# deploy/build-service-env.py (service `email`) checks it. With the variable
# unset the file is deleted and the email-worker container removed.
# tools/email_worker.py, modules/email_notify.py, migration 0103.
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is not
# below, and refuses a missing one. It is deliberately NOT the pipeline
# worker's file and NOT the notify worker's: this container holds the mail key
# and the Supabase service key and nothing else. The transport
# (NIGHTSHIFT_EMAIL_TRANSPORT=resend) is fixed in docker-compose.yml.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# [secret] The project URL; the same secret the bot and the pipeline worker use.
SUPABASE_URL=https://your-project.supabase.co
# [secret] The same repository secret the pipeline worker uses.
SUPABASE_SERVICE_KEY=
# [secret] Resend API key; the operator alert mail already uses this name.
RESEND_API_KEY=
# [var] The sender, e.g. Nightshift <hello@your-domain> (a domain verified in
#   Resend). Not a secret.
NIGHTSHIFT_EMAIL_FROM=
# [var] https://<the app>, no path: the origin every link in a mail is built
#   on. Optional: when the variable NOTIFY_APP_ORIGIN is empty the workflow
#   uses https://<DOMAIN>.
APP_ORIGIN=https://your-domain.example
