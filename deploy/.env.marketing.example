# Nightshift brand-channel poster (Telegram) — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.marketing (mode 600) from GitHub on every deploy while the
# GitHub repository variable NIGHTSHIFT_MARKETING_WORKER is `on`, and
# deploy/build-service-env.py (service `marketing`) checks it. With the variable
# unset, or anything but `on`, the file is deleted and the marketing-worker
# container removed. tools/marketing_worker.py, docs/MARKETING_POSTS.md, migration 0108.
#
# TWO switches, both default off, and both must be `on` for a post to go out:
#   NIGHTSHIFT_MARKETING_WORKER  (deploy)  whether this container exists at all
#   NIGHTSHIFT_MARKETING_POSTS   (below)   whether it drafts and sends; anything but `on` and it idles
# The database has a third (marketing_settings.enabled, false until the owner re-arms it).
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is not
# below, and refuses a missing one. It is deliberately NOT the pipeline worker's
# file, NOT the notify worker's and NOT the operator bot's: this container holds
# the brand channel's own bot token and the Supabase service key, and nothing
# else. It never reads TELEGRAM_BOT_TOKEN (operator bot) or
# TELEGRAM_CUSTOMER_BOT_TOKEN (customer bot): the customer bot must not be able
# to post publicly.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# [secret] The project URL; the same secret the bot and the pipeline worker use.
SUPABASE_URL=https://your-project.supabase.co
# [secret] Calls claim_marketing_post / complete_marketing_post / marketing_draft_upsert
#   with the service key (CLAUDE.md #3: never in the Command Center). The same
#   repository secret the pipeline worker uses.
SUPABASE_SERVICE_KEY=
# [secret] The DEDICATED channel bot's token from @BotFather, an administrator of
#   the channel with "Post messages" only. A new bot, not the operator's or the customer's.
TELEGRAM_CHANNEL_BOT_TOKEN=
# [var] The ONE channel it posts to: @channelname or a numeric id (-100...). Point it
#   at a private test channel first (docs/MARKETING_POSTS.md). Not a secret.
MARKETING_TELEGRAM_CHAT=@your_channel
# [var] https://<our site>, no path: the origin in front of a post's link. Optional:
#   when the variable NOTIFY_APP_ORIGIN is empty the workflow uses https://<DOMAIN>.
NOTIFY_APP_ORIGIN=https://your-domain.example
# [var] `on` lets the worker draft and send; empty or anything else and it does
#   nothing at all (it idles and reports "off" to worker_status). May be empty.
NIGHTSHIFT_MARKETING_POSTS=
