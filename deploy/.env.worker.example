# Nightshift pipeline worker — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.worker (mode 600) from the repository's GitHub Actions
# secrets and variables on every deploy while the GitHub variable
# NIGHTSHIFT_WORKER is `on` — the same values the daily_video workflow already
# uses, under the same names. With NIGHTSHIFT_WORKER unset the file is deleted
# and the worker container removed. See docs/DEPLOY_AX42.md, "Worker".
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is
# not below (it also accepts CHRONOS_YT_TOKEN_<REF> lines, which the workflow
# no longer sends: channels other than the default publish from the worker
# through their Supabase Vault connection — connect them on the Channels page).
#
# The worker's file is NOT the dashboard's: .env.web never gets the Supabase
# service key or a pipeline key, and this file never reaches the web container.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# ─── Queue (required) ────────────────────────────────────────────────────────
# [secret] The worker claims render_jobs with the service key. It lives only
#          here, never in the Command Center (CLAUDE.md #3).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ─── Pipeline keys ───────────────────────────────────────────────────────────
# [secret]
GEMINI_API_KEY=
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_CHANNEL_ID=
# [secret] OAuth client and the default channel's token (JSON; the workflow
#          compacts it to one line).
YOUTUBE_CLIENT_SECRET_JSON=
YOUTUBE_TOKEN_JSON=
# [secret] The Command Center's OAuth client: refreshes the Vault tokens of
#          customer channels AND of your own channels connected with the
#          Connect YouTube button (a refresh token only works with the client
#          that minted it).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# [secret] The Command Center's TikTok app (docs/SOCIAL_SETUP.md): refreshes
#          connected TikTok accounts' tokens (migration 0028). Instagram needs
#          no app secret to refresh. Empty = TikTok publishing is refused.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Providers (optional) ────────────────────────────────────────────────────
# [secret]
MINIMAX_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
VEO_API_KEY=
SEEDANCE_API_KEY=
WAN_API_KEY=
LEONARDO_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
FAL_KEY=
OPENAI_API_KEY=
VIDIQ_ACCESS_TOKEN=
# [secret] Creative OS adapters (modules/capabilities): Runway and the Luma
#          Agents API. Kling (KLING_API_KEY, or KLING_ACCESS_KEY + KLING_SECRET_KEY)
#          and Wan (WAN_API_KEY, WAN_WORKSPACE_ID) reuse the keys above.
RUNWAYML_API_SECRET=
LUMA_AGENTS_API_KEY=
# [secret] Creative OS adapters with no vendor built in: speech-to-text
#          (AssemblyAI, modules/capabilities/transcribe.py) and the video
#          edit / reframe / remove-background adapter (video_ops.py; its host
#          and paths are the VIDEO_OPS_* variables below).
ASSEMBLYAI_API_KEY=
VIDEO_OPS_API_KEY=

# ─── Behaviour (optional; same meaning as in daily_video.yml) ────────────────
# [var]
TTS_PROVIDER=
NIGHTSHIFT_EXPECT_TTS=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SECONDARY_VOICE_ID=
CHRONOS_RENDER_BACKEND=
NIGHTSHIFT_RENDER_THREADS=
NIGHTSHIFT_RENDER_JOBS=
WORKER_JOB_TIMEOUT_SECONDS=
NIGHTSHIFT_MIN_FREE_DISK_GB=
CHRONOS_VIDEO_PROVIDER=
CHRONOS_ENABLE_VIDEO_GEN=
CHRONOS_ENABLE_MINIMAX_BROLL=
MINIMAX_H3_MODEL=
MINIMAX_V2_QUERY_PATH=
WAN_WORKSPACE_ID=
CHRONOS_IMAGE_PROVIDER=
CHRONOS_ENABLE_IMAGE_GEN=
CHRONOS_IMAGE_MODEL=
CHRONOS_ENABLE_VIDIQ=
CHRONOS_AGENT_AUTOPILOT=
CHRONOS_AI_CRITIC=
NIGHTSHIFT_AVATAR_ENABLED=
HIGGSFIELD_AVATAR_ENDPOINT=
# The fal.ai presenter (NIGHTSHIFT_AVATAR_PROVIDER=fal, key FAL_KEY above; fal.ai is prepaid). Intro and
# outro only, with a seconds and USD ceiling checked before any request. All optional (defaults in modules/avatar_fal.py).
NIGHTSHIFT_AVATAR_PROVIDER=
NIGHTSHIFT_AVATAR_FAL_MODEL=
NIGHTSHIFT_AVATAR_FAL_IMAGE_MODEL=
NIGHTSHIFT_AVATAR_INTRO_SECONDS=
NIGHTSHIFT_AVATAR_OUTRO_SECONDS=
NIGHTSHIFT_AVATAR_MAX_SECONDS=
NIGHTSHIFT_AVATAR_FAL_USD_PER_SECOND=
NIGHTSHIFT_AVATAR_MAX_USD=
# [var] Kept for the Actions settle step; the queue worker no longer reads it.
#   Since migration 0041 a customer organization's job without an open credit
#   hold, or without its frozen length, is failed whatever this says
#   (modules/credits.open_queue_hold); the operator's own channels are unaffected.
NIGHTSHIFT_CREDITS_ENFORCE=
# [var] The creative worker's switch (tools/creative_worker.py, migration
#   0036): `on` = every deploy starts it, or recreates it on the new image,
#   next to the pipeline worker; anything else = it is stopped and removed.
#   Only with NIGHTSHIFT_WORKER=on as well (it shares this file). Read by
#   deploy/remote-deploy.sh; no container reads it.
NIGHTSHIFT_CREATIVE_WORKER=

# ─── Models, hosts and caps (optional; every one is a repository VARIABLE) ───
# An empty variable means "use the code's default" (config.py reads each one as
# `os.getenv(NAME) or default`). Behaviour change to know about: SEEDANCE_RESOLUTION,
# WAN_RESOLUTION and LEONARDO_MODEL_ID used to be read as `os.getenv(NAME, default)`,
# so a variable set but EMPTY meant an empty string; now empty forces the default.
# The two counts (CHRONOS_MINIMAX_BROLL_MAX_CLIPS, CHRONOS_LEONARDO_MAX_IMAGES) take
# a whole number 0-50; anything else falls back to 2 with a warning. A *_BASE_URL
# must be https:// (a key is never sent over http; the run refuses it). A change
# reaches the worker only after Actions -> "Deploy web" is run again.
# [var] Gemini model for the script, research and fact-check.
GEMINI_MODEL=
# [var] Free fallback narrator's voice (Edge-TTS), used only when TTS_PROVIDER
#       is edge.
EDGE_TTS_VOICE=
# [var] MiniMax host: https://api.minimax.io (global keys) or
#       https://api.minimaxi.com (keys from the mainland-China console).
MINIMAX_BASE_URL=
# [var] How many clips / stills one video may buy (code default 2 each).
CHRONOS_MINIMAX_BROLL_MAX_CLIPS=
CHRONOS_LEONARDO_MAX_IMAGES=
# [var] Per-provider model, host and paths; pin them to the vendor's current docs.
KLING_MODEL=
KLING_BASE_URL=
KLING_SUBMIT_PATH=
KLING_QUERY_PATH=
VEO_MODEL=
VEO_BASE_URL=
VEO_RESOLUTION=
VEO_SUBMIT_PATH=
VEO_QUERY_PATH=
SEEDANCE_MODEL=
SEEDANCE_BASE_URL=
SEEDANCE_RESOLUTION=
SEEDANCE_SUBMIT_PATH=
SEEDANCE_QUERY_PATH=
WAN_MODEL=
WAN_BASE_URL=
WAN_RESOLUTION=
WAN_SUBMIT_PATH=
WAN_QUERY_PATH=
HIGGSFIELD_MODEL=
HIGGSFIELD_BASE_URL=
HIGGSFIELD_SUBMIT_PATH=
HIGGSFIELD_QUERY_PATH=
LEONARDO_MODEL_ID=
# [var] Creative OS adapters with no vendor built in (modules/capabilities):
#       https only; the video-ops paths take {id} where the task id goes.
ASSEMBLYAI_BASE_URL=
VIDEO_OPS_BASE_URL=
VIDEO_OPS_SUBMIT_PATH=
VIDEO_OPS_QUERY_PATH=

# ─── Spend: prices and hard caps (optional, but the caps need the prices) ────
# [var] USD per SINGLE unit (per token, per character, per second, per clip),
#       as the vendor bills you, e.g. CHRONOS_PRICE_TTS_CHARACTERS=0.00018.
#       modules/cost_ledger.py prices a run's quantities with these; a unit with
#       no price is recorded without USD and the caps below cannot see it.
CHRONOS_PRICE_GEMINI_INPUT_TOKENS=
CHRONOS_PRICE_GEMINI_OUTPUT_TOKENS=
CHRONOS_PRICE_TTS_CHARACTERS=
CHRONOS_PRICE_RENDER_SECONDS=
CHRONOS_PRICE_PEXELS_REQUESTS=
CHRONOS_PRICE_UPLOAD_BYTES=
CHRONOS_PRICE_VIDEO_GEN_CLIPS=
CHRONOS_PRICE_IMAGE_GENERATIONS=
CHRONOS_PRICE_VISION_CALLS=
# [var] Hard caps, USD (modules/spend_guard.py). A run stops, with a message
#       naming the variable, before the next stage that buys something once its
#       ledger is over CHRONOS_MAX_RUN_USD (default 10), or, for the operator's
#       own organisation, once today's (UTC) ledger on this worker is over
#       CHRONOS_MAX_DAILY_USD (default 30). Empty = the default; `off` = no cap.
CHRONOS_MAX_RUN_USD=
CHRONOS_MAX_DAILY_USD=
# [var] Grounded fact-check (modules/grounding.py, docs/GROUNDED_FACTCHECK.md): the fact-check also looks the
#       claims up in the English Wikipedia (free, no key) and may clear a claim only with a quote that is verified
#       in code, or add a flag on a contradiction. ON when empty; `off` (also 0 / false / no / disabled / none)
#       switches it off.
NIGHTSHIFT_GROUNDED_FACTCHECK=
# [var] Fact-checker system prompt (modules/fact_checker.py, docs/GROUNDED_FACTCHECK.md): the checker sends its
#       system prompt (the three verdict words and the JSON schema) with every request. ON when empty; `off`
#       (also 0 / false / no / disabled / none) restores the request without it, the rollback switch.
NIGHTSHIFT_FACTCHECK_SYSTEM_PROMPT=
# [var] Packaging repair (modules/packaging_repair.py): when the fact-check blocks a run ONLY on packaging text
#       (title, A/B title, thumbnail text, alternate opening, hook sentence, description), those texts are
#       rewritten once and the same checker re-checks them. At most one extra generation call and one extra
#       fact-check call; narration is never touched. ON when empty; `off` (also 0 / false / no / disabled /
#       none) restores the plain hold.
NIGHTSHIFT_PACKAGING_REPAIR=
# [var] Topic selection gate (modules/topic_gate.py). Every topic the system picks
#       is checked against the channel's niche and a small sensitive-topic screen;
#       --topic is never checked. Empty = the default.
#       CHRONOS_TOPIC_GATE            `off` is a logged rollback switch (default on)
#       CHRONOS_TOPIC_QUEUE_STALE_DAYS  a queued entry older than this is re-checked
#                                     before use (default 14; 0 = no age rule)
#       CHRONOS_TOPIC_GATE_MODEL_CALLS  small niche questions per run (default 2; 0 = never ask)
CHRONOS_TOPIC_GATE=
CHRONOS_TOPIC_QUEUE_STALE_DAYS=
CHRONOS_TOPIC_GATE_MODEL_CALLS=
# [var] Days a topic of a run held BEFORE the render (the fact-check would block the gate) is not proposed again
#       by the system's topic pick; it is never registered as used or published. Empty = 14; 0 = off; capped
#       at 90. An explicit topic (a dispatch's `topic`, --topic) is never held back.
CHRONOS_HELD_TOPIC_COOLDOWN_DAYS=

# ─── Dormant features (OFF while empty; every one is a repository VARIABLE) ──
# Each of these is read by code that is finished and tested but had no way to be set on the managed
# path, because this file is the allow-list the deploy writes /opt/nightshift/.env.worker from. They
# are here so that turning one on is a decision (set the variable, then Actions -> "Deploy web"), not
# a code change. Empty = off / the code's default, exactly as before this block existed; nothing is
# set by the repository. tests/test_switch_reachability.py keeps this list in step with the code.
# [var] Scene-by-scene render with a cache (modules/scene_render.py). `1`/`true`/`yes`/`on` = on;
#       empty or anything else = the default whole-video render. Changes how every video is rendered.
CHRONOS_SCENE_RENDER=
# [var] Remotion for the scenes that prefer it (modules/remotion_renderer.py). Does nothing until the
#       worker image has Node and video-engine/node_modules (it has neither today); then needs
#       CHRONOS_SCENE_RENDER too. Same truthy words; empty = off. See video-engine/README.md.
CHRONOS_REMOTION=
# [var] Designed cards (title, quote, stat, timeline, map) for the scenes the Director marked
#       (modules/graphic_recipes.py). Same truthy words; empty = off, plain footage.
CHRONOS_GRAPHIC_RECIPES=
# [var] Caps on the scene cache that CHRONOS_SCENE_RENDER fills (modules/scene_cache_gc.py): total
#       megabytes and days to keep a scene. A number >= 0; empty or invalid = no cap, as today.
CHRONOS_SCENE_CACHE_MAX_MB=
CHRONOS_SCENE_CACHE_MAX_AGE_DAYS=
# [var] Comment inbox (tools/queue_worker.py, docs/WORKER_VPS.md, migration 0081). `on`/`1`/`true`/`yes`
#       = on; empty = off. It spends YouTube quota and classifier calls. The sync gap is seconds between
#       channels (empty or not a whole number = 300).
NIGHTSHIFT_COMMENT_INBOX=
NIGHTSHIFT_INBOX_SYNC_SECONDS=
# [var] Publish when approved (modules/visibility_publish.py, docs/APPROVE_PUBLISH_1B.md, migration
#       0116): the worker's own switch, the first of two locks (a channel's administrators hold the
#       second). `on`/`1`/`true`/`yes` = on; empty = off. CLAUDE.md #2: do not set it before the live
#       test that document lists. The three below only matter once it is on: this feature's YouTube
#       units a day (empty = 1000), one organization's share in percent (empty = 50), and the label
#       of the Google Cloud project in the quota ledger (empty = default).
NIGHTSHIFT_VISIBILITY_PUBLISH=
NIGHTSHIFT_VISIBILITY_DAILY_UNITS=
NIGHTSHIFT_VISIBILITY_ORG_PERCENT=
NIGHTSHIFT_YT_QUOTA_PROJECT=
# [var] Thumbnail A/B arms (config.py, modules/ab_testing.py): a whole number 2-4. Empty = 2, today's
#       A/B. More arms is a picture choice only (no extra upload), but each arm is rendered.
CHRONOS_THUMBNAIL_VARIANTS=
# [var] Ask Gemini for schema-constrained JSON in the research step (config.py, a spike). Truthy words
#       as above; empty = off, today's prompt-and-extract path.
CHRONOS_GEMINI_STRUCTURED_OUTPUT=
# [var] The synthetic presenter's character (modules/avatar.py), used only when NIGHTSHIFT_AVATAR_ENABLED
#       is on: a description of the look, and a reference image URL. One line, no `$`. Empty = no
#       description (the series' visual style seeds it when there is one). A real person's likeness is
#       refused by the presenter's own guard.
NIGHTSHIFT_AVATAR_CHARACTER_PROMPT=
NIGHTSHIFT_AVATAR_CHARACTER_REF=
