# Nightshift pipeline worker — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.worker (mode 600) from the repository's GitHub Actions
# secrets and variables on every deploy while the GitHub variable
# NIGHTSHIFT_WORKER is `on` — the same values the daily_video workflow already
# uses, under the same names. With NIGHTSHIFT_WORKER unset the file is deleted
# and the worker container removed. See docs/DEPLOY_AX42.md, "Worker".
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is
# not below (it also accepts CHRONOS_YT_TOKEN_<REF> lines, which the workflow
# no longer sends: channels other than the default publish from the worker
# through their Supabase Vault connection — connect them on the Channels page).
#
# The worker's file is NOT the dashboard's: .env.web never gets the Supabase
# service key or a pipeline key, and this file never reaches the web container.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# ─── Queue (required) ────────────────────────────────────────────────────────
# [secret] The worker claims render_jobs with the service key. It lives only
#          here, never in the Command Center (CLAUDE.md #3).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ─── Pipeline keys ───────────────────────────────────────────────────────────
# [secret]
GEMINI_API_KEY=
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_CHANNEL_ID=
# [secret] OAuth client and the default channel's token (JSON; the workflow
#          compacts it to one line).
YOUTUBE_CLIENT_SECRET_JSON=
YOUTUBE_TOKEN_JSON=
# [secret] The Command Center's OAuth client: refreshes customer channels'
#          Vault tokens (a refresh token only works with the client that
#          minted it).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Providers (optional) ────────────────────────────────────────────────────
# [secret]
MINIMAX_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
KLING_API_KEY=
VEO_API_KEY=
SEEDANCE_API_KEY=
WAN_API_KEY=
LEONARDO_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VIDIQ_ACCESS_TOKEN=

# ─── Behaviour (optional; same meaning as in daily_video.yml) ────────────────
# [var]
TTS_PROVIDER=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
CHRONOS_RENDER_BACKEND=
NIGHTSHIFT_RENDER_THREADS=
NIGHTSHIFT_RENDER_JOBS=
CHRONOS_VIDEO_PROVIDER=
CHRONOS_ENABLE_VIDEO_GEN=
CHRONOS_ENABLE_MINIMAX_BROLL=
CHRONOS_IMAGE_PROVIDER=
CHRONOS_ENABLE_IMAGE_GEN=
CHRONOS_IMAGE_MODEL=
CHRONOS_ENABLE_VIDIQ=
CHRONOS_AGENT_AUTOPILOT=
CHRONOS_AI_CRITIC=
NIGHTSHIFT_AVATAR_ENABLED=
HIGGSFIELD_AVATAR_ENDPOINT=
# [var] Fail customer jobs that have no open credit hold (modules/credits.py).
NIGHTSHIFT_CREDITS_ENFORCE=
