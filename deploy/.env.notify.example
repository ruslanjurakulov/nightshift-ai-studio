# Nightshift customer-notification worker (Telegram) — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.notify (mode 600) from GitHub on every deploy while the
# GitHub repository variable NIGHTSHIFT_NOTIFY_WORKER is `on`, and
# deploy/build-service-env.py (service `notify`) checks it. With the variable
# unset the file is deleted and the notify-worker container removed.
# docs/NOTIFY_TELEGRAM_SETUP.md.
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is not
# below, and refuses a missing one. It is deliberately NOT the pipeline
# worker's file: this container never holds the provider keys, and the
# pipeline worker never holds the customer bot's token.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# [secret] The project URL; the same secret the bot and the pipeline worker use.
SUPABASE_URL=https://your-project.supabase.co
# [secret] Claims the outbox with the service key (CLAUDE.md #3: never in the
#   Command Center). The same repository secret the pipeline worker uses.
SUPABASE_SERVICE_KEY=
# [secret] The CUSTOMER bot's token from @BotFather. Not the operator bot's
#   TELEGRAM_BOT_TOKEN, which nothing here reads.
TELEGRAM_CUSTOMER_BOT_TOKEN=
# [var] https://<the app>, no path: the link back in a message. Optional: when
#   the variable NOTIFY_APP_ORIGIN is empty the workflow uses https://<DOMAIN>.
NOTIFY_APP_ORIGIN=https://your-domain.example
