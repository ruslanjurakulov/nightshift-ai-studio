# Nightshift brand scan worker (Ads Factory, Phase 2) — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.brandscan (mode 600) from GitHub on every deploy while the
# GitHub repository variable NIGHTSHIFT_ADS_BRAND_SCAN is `on`, and
# deploy/build-service-env.py (service `brandscan`) checks it. With the variable
# unset, or anything but `on`, the file is deleted and the brand-scan-worker
# container removed. tools/brand_scan_worker.py, docs/ADS_FACTORY.md, migrations 0133 and 0134.
#
# ONE switch, NIGHTSHIFT_ADS_BRAND_SCAN: the same repository variable shows the
# "Scan my site" panel in the Command Center. The database has its own: a scan is
# not on sale while brand_scan_settings.price_credits is NULL (the owner sets it
# at go-live, after the worker runs).
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is not
# below, and refuses a missing one. It is deliberately NOT the pipeline worker's
# file: this container holds the Supabase service key and nothing else, never a
# provider key or a bot token.
#
# Legend:  [secret]  repository secret      [var]  repository variable

# [secret] The project URL; the same secret the bot and the pipeline worker use.
SUPABASE_URL=https://your-project.supabase.co
# [secret] Calls 0133's worker functions (claim_domain_check, finish_domain_check,
#   claim_brand_scan, finish_brand_scan, fail_brand_scan) and register_asset with the
#   service key (CLAUDE.md #3: never in the Command Center). The same repository secret
#   the pipeline worker uses.
SUPABASE_SERVICE_KEY=
# [var] `on`: the worker claims checks and scans. The deploy writes this file only
#   while it is `on`, so it is always `on` here.
NIGHTSHIFT_ADS_BRAND_SCAN=on
