# Nightshift Command Center — server environment template.
#
# Copy to /opt/nightshift/.env.web on the server (outside the git checkout),
# fill in real values there, and keep it `chmod 600`. Never commit the filled
# copy. Every value below is a placeholder.
#
# Values: plain KEY=value, no quotes needed, no spaces around "=". Avoid "$"
# in a value (compose would try to interpolate it); if one must contain "$",
# write it as "$$".
#
# Legend:  [compose]      read by docker-compose.yml (Caddy / image build)
#          [public]       baked into the browser bundle at BUILD time
#          [server-only]  runtime only, never reaches the browser
#
# The Supabase SERVICE key does not belong here, or anywhere in the Command
# Center. It is the bot's alone.

# ─── Server / TLS ────────────────────────────────────────────────────────────
# [compose] The name the dashboard is served on (no https://, no slash).
#           compose also derives APP_ORIGIN=https://<DOMAIN> from it.
DOMAIN=nightshift-ai.studio
# [compose] Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.com

# ─── Supabase (Settings -> API) ──────────────────────────────────────────────
# [public] Project URL. Changing it needs a rebuild (up -d --build).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [public] The ANON key only. Changing it needs a rebuild.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Operator details for /privacy and /terms ────────────────────────────────
# [public] Printed on the public legal pages (Google OAuth verification needs
#   them). Empty or invalid shows NOT CONFIGURED. Changing needs a rebuild.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=
# [public] YYYY-MM-DD, the date the current texts take effect.
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=

# ─── Buying credits with Paddle (docs/PADDLE_SETUP.md) ───────────────────────
# [public] Paddle Billing overlay checkout on the Credits page. Changing any of
#   these needs a rebuild. Empty token = the Buy credits panel is hidden.
#   The webhook that credits purchases is a Supabase Edge Function with its own
#   secrets (PADDLE_WEBHOOK_SECRET is set there, never here).
# [public] sandbox (default) | production; token test_… / live_… must match.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# [public] One Paddle price id (pri_…) per credit pack; empty = not offered.
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_CREATOR=
NEXT_PUBLIC_PADDLE_PRICE_STUDIO=

# ─── Public API balance top-ups with Paddle (docs/API.md) ────────────────────
# [server-only] A Paddle API key (Paddle -> Developer tools -> Authentication)
#   with permission to write transactions and read invoices. Used only by
#   /api/developers/* to create a top-up transaction for a custom amount and to
#   fetch its invoice; never sent to a browser. Must belong to the same Paddle
#   environment as NEXT_PUBLIC_PADDLE_ENV. Empty = the Developer console's Top
#   up says "not available yet".
PADDLE_API_KEY=
# [server-only] The Paddle product the custom top-up prices belong to (pro_…),
#   e.g. "Nightshift API balance top-up", tax category "standard digital goods".
#   Set the same id as PADDLE_API_TOPUP_PRODUCT_ID on the paddle-webhook Edge
#   Function, which credits only lines of this product.
PADDLE_API_TOPUP_PRODUCT_ID=

# ─── Public pricing page (/pricing) and credit terms ─────────────────────────
# [public] The price shown for each pack on /pricing, exactly as written
#   (e.g. $10). With Paddle configured, Paddle's own localized price is shown
#   and these are only the fallback. All empty and no Paddle = the page says
#   "pricing coming soon". Must match what Paddle charges. Rebuild to change.
NEXT_PUBLIC_PRICE_DISPLAY_STARTER=
NEXT_PUBLIC_PRICE_DISPLAY_CREATOR=
NEXT_PUBLIC_PRICE_DISPLAY_STUDIO=

# ─── Monthly plans (migration 0034, docs/BILLING_PLANS.md) ──────────────────
# The monthly Paddle price id (pri_…) of each plan; the same ids go into the
# paddle-webhook secrets as PADDLE_PLAN_CREATOR / _PRO / _STUDIO. A plan with
# no price id is not offered for checkout. Display prices are plain text shown
# until Paddle's own localized price loads — write "19 USD", never a dollar sign.
NEXT_PUBLIC_PADDLE_PLAN_CREATOR=
NEXT_PUBLIC_PADDLE_PLAN_PRO=
NEXT_PUBLIC_PADDLE_PLAN_STUDIO=
NEXT_PUBLIC_PLAN_DISPLAY_CREATOR=
NEXT_PUBLIC_PLAN_DISPLAY_PRO=
NEXT_PUBLIC_PLAN_DISPLAY_STUDIO=
# [public] Whole months after purchase that unused credits expire, for the
#   Terms and /pricing. Empty = "credits do not expire" — which is what the
#   system does: nothing expires credits automatically, so set this only once
#   you have decided to (and a lawyer has agreed). Rebuild to change.
NEXT_PUBLIC_CREDITS_EXPIRY_MONTHS=

# ─── GitHub Actions secrets forwarding (optional) ────────────────────────────
# [server-only] Fine-grained token scoped to the bot repository only, with
#   Repository permissions "Secrets", "Variables" and "Actions" (for Run now)
#   set to "Read and write". Nothing else.
#   Empty = the wizard says forwarding is off and tells you to add keys by hand.
GITHUB_SECRETS_TOKEN=
# [server-only] owner/repo of the bot repository.
GITHUB_SECRETS_REPO=owner/repo
# [server-only] Branch that "Run now" dispatches. Empty = main.
GITHUB_SECRETS_REF=

# ─── "Run now" backend ───────────────────────────────────────────────────────
# [server-only] Empty / "actions" (default): Run now dispatches the GitHub
#   Actions workflow. "queue": it adds a render_jobs row (migration 0017) for
#   the VPS worker (docs/WORKER_VPS.md). Any other value means actions.
NIGHTSHIFT_RUN_BACKEND=

# [server-only] Prepaid credits (migration 0020). Empty / anything but 1|true|
#   yes|on (default): off — runs start without a credit hold, as before. On:
#   Run now for a channel outside the operator's own (default) organization
#   first reserves its estimated cost, and refuses when the organization lacks
#   the credits. With the queue backend and this off, a customer organization's
#   Run now is refused (the database and the worker refuse a customer's job
#   without a hold, migration 0041); the operator's own channels run as before.
#   See supabase/migrations/0020_credits.sql and 0041_run_billing_hardening.sql.
NIGHTSHIFT_CREDITS_ENFORCE=

# ─── YouTube connect (optional) ──────────────────────────────────────────────
# [server-only] Google OAuth "Web application" client. Its authorized redirect
#   URI must be https://<DOMAIN>/api/oauth/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
# [server-only]
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Instagram / TikTok connect (optional) ───────────────────────────────────
# See docs/SOCIAL_SETUP.md. Empty = the Channels page shows "not available yet"
#   for that platform instead of a Connect button.
# [server-only] Meta app → Instagram → "API setup with Instagram login":
#   Instagram app ID / secret. Redirect URI to register:
#   https://<DOMAIN>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
# [server-only]
INSTAGRAM_APP_SECRET=
# [server-only] TikTok for Developers app: Client key / Client secret. Redirect
#   URI to register: https://<DOMAIN>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
# [server-only]
TIKTOK_CLIENT_SECRET=

# ─── Alerts (optional) ───────────────────────────────────────────────────────
# [server-only] Slack incoming webhook for the "Send test" button. Empty = the
#   test alert is recorded and queued for the pipeline instead of sent here.
SLACK_WEBHOOK_URL=

# ─── Media library (migration 0038) ──────────────────────────────────────────
# [server-only] The key that signs the short-lived links (/api/media/file/…)
#   the library hands to <img>, <video> and API clients. At least 32 random
#   characters (e.g. `openssl rand -base64 48`, without "$"); shorter or empty
#   = the library shows no previews and serves no files. Changing it only
#   invalidates links already handed out (they live at most an hour).
MEDIA_URL_SECRET=

# ─── Content-Security-Policy (BR-S-008, docs/security/CSP.md) ────────────────
# [server-only] Empty or "report-only" = the policy is sent as
#   Content-Security-Policy-Report-Only: violations show in the browser console
#   (and go to CSP_REPORT_URI) but nothing is blocked. "enforce" = the same
#   policy is enforced. "off" = no content policy at all (frame-ancestors from
#   next.config.ts still applies). Read per request: a restart is enough.
CSP_MODE=
# [server-only] Optional https URL of a CSP report collector. Empty = reports
#   stay in the browser console only.
CSP_REPORT_URI=

# ─── Atelier design concepts (docs/design/ATELIER_CONCEPTS.md) ───────────────
# [server-only] Leave EMPTY on every real deploy. Only the literal "1" serves
#   the three prototype hero pages at /atelier/a, /b and /c (noindex, in no
#   sitemap); anything else, including unset, answers the public 404 for the
#   whole /atelier path. "1" makes the pages public but unlisted (anyone with the
#   URL can open them), not private. Read per request: a restart is enough.
ATELIER_CONCEPTS=
