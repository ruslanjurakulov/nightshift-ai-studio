# Nightshift Command Center — server environment template.
#
# Copy to /opt/nightshift/.env.web on the server (outside the git checkout),
# fill in real values there, and keep it `chmod 600`. Never commit the filled
# copy. Every value below is a placeholder.
#
# Values: plain KEY=value, no quotes needed, no spaces around "=". Avoid "$"
# in a value (compose would try to interpolate it); if one must contain "$",
# write it as "$$".
#
# Legend:  [compose]      read by docker-compose.yml (Caddy / image build)
#          [public]       baked into the browser bundle at BUILD time
#          [server-only]  runtime only, never reaches the browser
#
# The Supabase SERVICE key does not belong here, or anywhere in the Command
# Center. It is the bot's alone.

# ─── Server / TLS ────────────────────────────────────────────────────────────
# [compose] The name the dashboard is served on (no https://, no slash).
#           compose also derives APP_ORIGIN=https://<DOMAIN> from it.
DOMAIN=nightshift-ai.studio
# [compose] Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.com

# ─── Supabase (Settings -> API) ──────────────────────────────────────────────
# [public] Project URL. Changing it needs a rebuild (up -d --build).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [public] The ANON key only. Changing it needs a rebuild.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── GitHub Actions secrets forwarding (optional) ────────────────────────────
# [server-only] Fine-grained token scoped to the bot repository only, with
#   Repository permissions "Secrets", "Variables" and "Actions" (for Run now)
#   set to "Read and write". Nothing else.
#   Empty = the wizard says forwarding is off and tells you to add keys by hand.
GITHUB_SECRETS_TOKEN=
# [server-only] owner/repo of the bot repository.
GITHUB_SECRETS_REPO=owner/repo
# [server-only] Branch that "Run now" dispatches. Empty = main.
GITHUB_SECRETS_REF=

# ─── "Run now" backend ───────────────────────────────────────────────────────
# [server-only] Empty / "actions" (default): Run now dispatches the GitHub
#   Actions workflow. "queue": it adds a render_jobs row (migration 0017) for
#   the VPS worker (docs/WORKER_VPS.md). Any other value means actions.
NIGHTSHIFT_RUN_BACKEND=

# ─── YouTube connect (optional) ──────────────────────────────────────────────
# [server-only] Google OAuth "Web application" client. Its authorized redirect
#   URI must be https://<DOMAIN>/api/oauth/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
# [server-only]
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Alerts (optional) ───────────────────────────────────────────────────────
# [server-only] Slack incoming webhook for the "Send test" button. Empty = the
#   test alert is recorded and queued for the pipeline instead of sent here.
SLACK_WEBHOOK_URL=
