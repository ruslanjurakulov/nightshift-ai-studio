# Nightshift OPERATOR bot (Telegram) — server environment template.
#
# Nobody fills this in by hand. .github/workflows/deploy_web.yml builds
# /opt/nightshift/.env.operator (mode 600) from GitHub on every deploy while the
# GitHub repository variable NIGHTSHIFT_OPERATOR_BOT is `on`, and
# deploy/build-service-env.py (service `operator`) checks it. With the variable
# unset the file is deleted and the operator-bot container removed, and the two
# GitHub workflows (telegram_control.yml, operator_alerts.yml) work as before.
# tools/operator_bot_service.py, docs/operator-bot.md.
#
# This file is the allow-list: deploy/remote-deploy.sh refuses a key that is not
# below, and refuses a missing one (an optional key is present and may be
# empty). It is deliberately NOT the pipeline worker's file: this container
# never holds a provider key, and the customer bot's token is not here either.
#
# Legend:  [secret]  repository secret      [var]  repository variable
#          (required) the deploy fails before SSH when it is empty
#          (optional) empty is fine

# (required) [secret] The project URL; the same secret the workflows use.
SUPABASE_URL=https://your-project.supabase.co
# (required) [secret] The same repository secret as the workflows. It keeps the
#   bot's whole state: alert memory, mutes, the claimed Telegram updates.
SUPABASE_SERVICE_KEY=
# (required) [secret] The OPERATOR bot's token from @BotFather.
TELEGRAM_BOT_TOKEN=
# (required) [secret] The admin chat id: the only chat whose commands are honoured.
TELEGRAM_CHAT_ID=
# (optional) [secret] Who may command in a GROUP chat, comma-separated user ids.
TELEGRAM_ADMIN_USER_IDS=
# (optional) [secret OPERATOR_GITHUB_TOKEN] A READ-ONLY fine-grained token
#   (this repository, "Actions: read" and nothing else) for the /deploys and
#   /health views and the failed-deploy alert. GitHub reserves the name
#   GITHUB_TOKEN for its own use, so the secret is OPERATOR_GITHUB_TOKEN. Empty:
#   the public API is asked without a token (60 requests an hour, so the alert
#   pass slows to every 10 minutes) and a refused answer reads "unavailable".
GITHUB_TOKEN=
# (set by the workflow) owner/repo those views ask about: this repository.
GITHUB_REPOSITORY=
# (optional) [var] The low-balance line, as in provider_balances.yml.
ELEVENLABS_LOW_CREDITS=
# (optional) [var] The settings of docs/operator-bot.md, all with safe defaults.
OPERATOR_APP_URL=
OPERATOR_LANGUAGE=
OPERATOR_TZ=
OPERATOR_QUIET_HOURS=
OPERATOR_DIGEST_HOUR=
OPERATOR_STUCK_MINUTES=
OPERATOR_ALERT_MAX_PER_HOUR=
# (optional) [var] Hours after a channel's publish hour (UTC) by which its video must exist, or the
#   dead-man alert fires (docs/operator-bot.md). 1-12, empty = 3, `off` = no dead-man alert.
OPERATOR_DEADMAN_HOURS=
# (optional) [var] The owner's e-mail copy of the alerts and a daily digest
#   (docs/OWNER_EMAIL.md). OFF unless NIGHTSHIFT_OWNER_EMAIL is exactly `on`;
#   it then also needs RESEND_API_KEY and NIGHTSHIFT_EMAIL_FROM below. The
#   recipients are never set here: they are read from the platform roster
#   (confirmed owners and admins only). It rides the alert pass above, so it uses
#   the same OPERATOR_QUIET_HOURS, OPERATOR_DIGEST_HOUR (the digest's hour),
#   OPERATOR_ALERT_MAX_PER_HOUR and OPERATOR_LANGUAGE / the bot's /language.
NIGHTSHIFT_OWNER_EMAIL=
# (optional) [var] Which kinds to e-mail, comma-separated, from: payment, signup,
#   run, stuck, worker, deploy, marketing, pipeline, health, balance, audit,
#   approval. Empty: the first nine (up to and including health).
OWNER_EMAIL_KINDS=
# (optional) [secret OPERATOR_RESEND_API_KEY] The owner e-mail's OWN Resend key:
#   create a "Sending access" key restricted to your one sending domain (Resend
#   dashboard, API Keys) and store it as the repository secret
#   OPERATOR_RESEND_API_KEY. Do NOT reuse the customer e-mail worker's key. The
#   deploy passes it only while NIGHTSHIFT_OWNER_EMAIL is `on`; otherwise this
#   line is written empty.
RESEND_API_KEY=
# (optional) [var] The sender, e.g. Nightshift <alerts@your-domain> (a domain
#   verified in Resend); the same variable the customer e-mail worker uses.
NIGHTSHIFT_EMAIL_FROM=
