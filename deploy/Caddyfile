# Caddy in front of the Command Center (see docs/DEPLOY_AX42.md).
#
# {$DOMAIN} and {$ACME_EMAIL} come from the caddy service's environment in
# docker-compose.yml, which interpolates them from /opt/nightshift/.env.web
# (production: DOMAIN=nightshift-ai.studio).
#
# No proxy is in front of this server: the domain's A record points straight at
# it (read 2026-11-12: Porkbun nameservers, one A record, no AAAA). Caddy holds
# a real Let's Encrypt certificate for {$DOMAIN}, redirects HTTP to HTTPS itself
# and leaves /.well-known/acme-challenge/ reachable over HTTP, which is how the
# certificate is issued and renewed. So the peer of every connection is the
# visitor (or their VPN), and X-Nightshift-Client-IP below is that address.
# If a proxy or CDN is ever put in front, that line must change with it
# (docs/GEO_BLOCK.md): the peer would then be the proxy, not the visitor.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Every path is compressed except Nightshift AI's turn (POST /api/brain/turn), which is to stream its answer as NDJSON lines
	# (docs/studio/LIVE_CREATION_PLAN.md §3.4). Measured in the lab on Caddy 2.10.2, 2.11.4 and 2.11.9, `encode` compressed such a
	# stream and still held no line back (docs/studio/STREAM_PROXY_MEASUREMENT.md); but whether it encodes at all rests on the
	# Content-Type, the first write's size against minimum_length and a no-transform rule that changed in 2.11.8. Left out by path,
	# the stream rests on none of them. The exact path, as the proxy block for it below.
	@compressible not path /api/brain/turn
	encode @compressible zstd gzip

	header {
		# One year of HTTPS-only. includeSubDomains is deliberately absent: it
		# would bind every other name under the domain too, including ones that
		# are not served by this box.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# `?` = only when the app sent none. This block deletes headers, which makes
		# Caddy defer it and overwrite upstream values: a plain set here replaced the
		# app's `no-referrer` on pages whose URL is the secret (/r/<token>, /i/<token>,
		# /auth/*, signed media). tests/security/test_sec_link_leak_caddy.py.
		?Referrer-Policy "strict-origin-when-cross-origin"
		# What server and framework answered is nobody's business.
		-Server
		-X-Powered-By
	}

	# Permissions-Policy. payment= is opened to Paddle's checkout frame only
	# (the Buy credits overlay, docs/PADDLE_SETUP.md): with payment=() the
	# browser hides Apple Pay / Google Pay inside it. Our own page still gets
	# nothing. The microphone is allowed to this origin on ONE page, the
	# timeline editor's project page /<channel>/editor/<project uuid>, for a
	# voice-over (owner decision, 2026-11-11); the browser still asks the person
	# each time. Every other path, /api included, keeps microphone=(). The two
	# matchers below cannot both match one request, and the /api line only
	# repeats the deny, so no two lines with different values ever meet. The
	# `>` defers the write: it replaces what the app sent (next.config.ts sends
	# the same two values on the same paths), so each response carries exactly
	# one Permissions-Policy, Caddy's.
	@micPage {
		path_regexp ^/[^/]+/editor/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/?$
		not path /api/*
	}
	@noMicPage not path_regexp ^/[^/]+/editor/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/?$
	@noMicApi path /api/*
	header @micPage >Permissions-Policy `camera=(), microphone=(self), geolocation=(), payment=("https://buy.paddle.com" "https://sandbox-buy.paddle.com"), usb=()`
	header @noMicPage >Permissions-Policy `camera=(), microphone=(), geolocation=(), payment=("https://buy.paddle.com" "https://sandbox-buy.paddle.com"), usb=()`
	header @noMicApi >Permissions-Policy `camera=(), microphone=(), geolocation=(), payment=("https://buy.paddle.com" "https://sandbox-buy.paddle.com"), usb=()`

	# The dashboard is never meant to be framed; this closes clickjacking on
	# the buttons that write review intents. The one exception is the Mobile
	# view (command-center/lib/view-mode.ts): our own page framing itself, which
	# the browser marks Sec-Fetch-Dest: iframe. For those requests Caddy sends
	# nothing and the app decides, because it can also see Sec-Fetch-Site: it
	# answers SAMEORIGIN to a same-origin frame and DENY to a cross-site one
	# (command-center/middleware.ts). Every other request still gets DENY here.
	# The `>` defers the write until the response leaves, so it replaces whatever
	# the app sent: always exactly one X-Frame-Options line.
	@notFrame not header Sec-Fetch-Dest iframe
	header @notFrame >X-Frame-Options "DENY"

	# Whose address a request came from (docs/GEO_BLOCK.md: a model whose vendor
	# forbids some countries), in ONE header the app reads and no client can
	# choose: request_header replaces whatever the client sent with the address
	# of the peer that opened this connection. Nothing in front of Caddy is
	# trusted to name another address (there is nothing in front), so
	# CF-Connecting-IP, X-Real-IP and X-Forwarded-For from a client change
	# nothing here. X-Forwarded-For is still Caddy's own, as before.
	request_header X-Nightshift-Client-IP {remote_host}

	# `web` is reachable only on the compose network; it publishes no port of
	# its own, so this is the only way in. Caddy passes the original Host and
	# sets X-Forwarded-Proto/For itself.
	#
	# Every deploy recreates `web` (deploy/remote-deploy.sh, step 6), and for
	# those seconds there is nothing at web:3000 to dial. Without a retry window
	# Caddy answered each such request 502 at once (measured 2026-11-14: 502 for
	# about 5s per deploy, which a site verifier read as "unresponsive"). With
	# one, a request whose dial fails is held and the dial repeated every
	# lb_try_interval until the new container answers or lb_try_duration runs
	# out. Caddy retries a failed dial for any method (no request reached the
	# app), so a POST is never sent twice. 30s covers the old container's whole
	# stop grace (compose's default 10s) plus the new one's start, with room.
	reverse_proxy web:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}

	# Nightshift AI's plan step (POST /api/brain/turn, action `choose`; command-center/lib/server/brain/plan.ts) answers only once
	# the whole storyboard is written: up to its 280 s budget (PLAN_BUDGET_MS), then the draft's save and quote, inside the plan's
	# 320 s lease (migration 0211). Caddy sets no upstream timeout by default, so nothing cuts it today; this states the bound for
	# this ONE path, above the lease, so the plan is never cut short and a stuck answer is still closed. Every other path keeps the
	# proxy above, unchanged. A single path with no `*` sorts before the proxy with no matcher, so this one wins for this path only.
	# Same retry window as above while `web` is recreated: a failed dial is retried, a request the app received is never resent.
	# No flush_interval: Caddy's docs say a response whose Content-Length is unknown (a stream) is flushed after every write
	# whatever it is set to, and the lab measured exactly that; -1 would also stop a visitor's disconnect from reaching the app.
	reverse_proxy /api/brain/turn web:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
		transport http {
			response_header_timeout 330s
			read_timeout 330s
			write_timeout 330s
		}
	}

	# The access log must not become a store of live links: review/invite path
	# tokens and token_hash/code/t/sig/token query values are redacted before
	# the line is written (one regexp, so it also works on Caddy 2.10).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(/[ri]/)[^/?#]+|([?&](?:token_hash|code|t|sig|token)=)[^&#]*" "${1}${2}REDACTED"
			}
		}
	}
}
