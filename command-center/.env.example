# Chronos Command Center — environment
# Copy to .env.local for local dev, and set the same in the Vercel project.
#
# Both come from your Supabase project (Settings -> API). See docs/SUPABASE.md
# in the repo root. The dashboard uses the ANON key only (never the service
# key); Row Level Security + login keep the data private.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── GitHub Actions secrets forwarding (server-only) ───────────────────
# Set these and the Add Channel wizard can write API keys straight into the
# bot repository's Actions secrets, so a key typed in the dashboard is never
# stored here — it is sealed to the repo's public key, PUT to GitHub, dropped.
#
# NEVER prefix these NEXT_PUBLIC_: that would ship the token to the browser.
# In Vercel, add them as plain (server) Environment Variables.
#
# GITHUB_SECRETS_TOKEN: a fine-grained personal access token scoped to the one
#   repository below, with Repository permissions → "Secrets: Read and write".
#   Nothing else. Create it at
#   https://github.com/settings/personal-access-tokens/new
# GITHUB_SECRETS_REPO: owner/repo of the bot.
#
# Leave both empty and the wizard still works — it says forwarding is off and
# tells you to add the secrets on GitHub by hand.
GITHUB_SECRETS_TOKEN=
GITHUB_SECRETS_REPO=ruslanjurakulov/chronos_youtube_bot

# ─── Operator details for /privacy and /terms (public) ─────────────────
# Printed on the public Privacy Policy and Terms of Service, which Google's
# OAuth verification requires. Nothing is defaulted: a value left empty (or an
# invalid email / date) shows a visible NOT CONFIGURED marker on those pages
# instead of an invented name. See lib/legal.ts and
# docs/GOOGLE_OAUTH_VERIFICATION.md. Public by design — they are on the page.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=
# YYYY-MM-DD, the date the current texts take effect.
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=

# ── "Run now" backend ───────────────────────────────────────────────────────
# Where "Run now" sends a run. Empty / "actions" (default): dispatch the
# daily-video workflow on GitHub Actions. "queue": insert a render_jobs row
# (migration 0017) for the VPS worker (docs/WORKER_VPS.md). Server-only; any
# other value means actions. The web app never needs the service key for this.
NIGHTSHIFT_RUN_BACKEND=

# ─── Self-hosted only ───────────────────────────────────────────────────
# APP_ORIGIN: the public origin (https://app.example.com) used to build the
#   YouTube OAuth redirect URI. Behind a reverse proxy the server cannot see
#   it; deploy/docker-compose.yml sets it from DOMAIN. Leave unset on Vercel
#   and locally. Full server template: deploy/.env.web.example
