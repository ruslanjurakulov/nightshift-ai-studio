# ─── AI APIs ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here        # optional, only if TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB           # optional
ELEVENLABS_SECONDARY_VOICE_ID=                      # voice for quoted lines, from your account's list; "narrator" = same voice

# ─── Media ─────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ─── AI b-roll (MiniMax) ───────────────────────────────────
# Optional: generate on-topic b-roll for a few sections instead of stock.
# OFF unless BOTH a key is set AND CHRONOS_ENABLE_MINIMAX_BROLL is truthy.
# When ON, every selected section must get its generated clip: a refusal stops
# the run with the remedy instead of quietly using stock footage.
# The model id picks MiniMax's API: MiniMax-Hailuo-2.3 (v1, the flow MiniMax's
# own client runs) or MiniMax-H3 (v2). H3 also needs MINIMAX_V2_QUERY_PATH from
# MiniMax's current v2 docs ({id} = the task id); without it an H3 run refuses
# to start.
MINIMAX_API_KEY=                                    # optional; no key = feature off
MINIMAX_BASE_URL=https://api.minimax.io             # api.minimaxi.com for a mainland-China key
MINIMAX_H3_MODEL=MiniMax-H3                         # or MiniMax-Hailuo-2.3
MINIMAX_V2_QUERY_PATH=                              # required for MiniMax-H3*
CHRONOS_ENABLE_MINIMAX_BROLL=                       # 1/true to enable when a key is set
CHRONOS_MINIMAX_BROLL_MAX_CLIPS=2                   # generated clips per video (cost control)

# ─── Telegram control panel (the OPERATOR bot) ─────────────
# Optional: notifications, read-only views (/health /queue /errors /balance
# /spend /today /users /deploys /approvals /digest ...), inline buttons,
# proactive alerts. View-only: it cannot publish, pause, resume, pay or grant anything.
# Off unless BOTH are set. TELEGRAM_CHAT_ID is the admin chat —
# the ONLY chat whose commands are honoured, and only from the people allowed
# below (a command is authorised by its SENDER, not by the chat). Polled by
# tools/run_telegram_control.py (.github/workflows/telegram_control.yml); alerts
# by tools/run_operator_alerts.py (.github/workflows/operator_alerts.yml).
# Full guide and go-live steps: docs/operator-bot.md.
TELEGRAM_BOT_TOKEN=                                  # from @BotFather
TELEGRAM_CHAT_ID=                                    # your admin chat id
# Telegram user ids allowed to command, comma-separated. Not needed for a
# private chat with the bot (its chat id IS your user id); required for a group
# chat — until it is set, nobody in the group can command.
TELEGRAM_ADMIN_USER_IDS=
# Optional operator-bot settings (all have safe defaults; none is a price):
OPERATOR_APP_URL=                                    # https://your-domain — deep links and the site check; unset = no links
OPERATOR_LANGUAGE=                                   # en | ru | uz — the language until you pick one with /language (default en)
OPERATOR_TZ=                                         # IANA name, e.g. Asia/Tashkent (default UTC): quiet hours, digest, "today"
OPERATOR_QUIET_HOURS=                                # e.g. 23-7 — only critical alerts go out in this window (local time)
OPERATOR_DIGEST_HOUR=                                # 0-23 local: send the daily digest then; unset = no digest
OPERATOR_STUCK_MINUTES=30                            # a queued job waiting longer than this counts as stuck
OPERATOR_ALERT_MAX_PER_HOUR=6                        # non-critical alerts per hour; critical ones are never held
OPERATOR_DEADMAN_HOURS=3                             # 1-12: hours after a channel's publish hour (UTC) with no video before the dead-man alert; `off` disables it
NIGHTSHIFT_PIPELINE_PAUSED=                          # true = the scheduled pipeline is paused (no dead-man alert, digest says `paused`, one daily reminder); empty/false = running
# The owner's e-mail copy of these alerts + a daily digest (docs/OWNER_EMAIL.md). OFF unless the first is exactly `on`.
# Recipients are never set here: confirmed platform owners/admins are read from the roster on the server.
NIGHTSHIFT_OWNER_EMAIL=                              # exactly `on` to enable; anything else = off
OWNER_EMAIL_KINDS=                                   # payment,signup,run,stuck,worker,deploy,marketing,pipeline,health (+ balance,audit,approval); empty = those nine
RESEND_API_KEY=                                      # secret; a restricted Resend "Sending access" key of its own (deploy secret OPERATOR_RESEND_API_KEY), not the customer worker's
NIGHTSHIFT_EMAIL_FROM=                               # e.g. Nightshift <alerts@your-domain> (a domain verified in Resend)
NIGHTSHIFT_EMAIL_TRANSPORT=                          # empty = resend; `fake` writes to a folder and sends nothing (local runs)
NIGHTSHIFT_EMAIL_FAKE_DIR=                           # where `fake` writes (default output/email-fake)
# Webhook mode only (tools/operator_bot_server.py, optional, see docs/operator-bot.md):
TELEGRAM_WEBHOOK_SECRET=                             # 16-256 of A-Za-z0-9_- ; Telegram echoes it in a header
# Read-only deploy / CI status for /deploys and /health. Both are supplied by
# GitHub Actions itself (the job token needs only `actions: read`); outside
# Actions you would set them by hand.
GITHUB_TOKEN=
GITHUB_REPOSITORY=                                   # owner/repo
# The low-balance line the alerts use is the existing one:
#   ELEVENLABS_LOW_CREDITS (see the provider-balance settings; default 15000)

# ─── Customer notifications on Telegram (migration 0102) ──
# A SEPARATE bot from the operator one above (never reuse its token). Names only;
# values go in the notify worker's own env file (.env.notify) / Supabase secrets, never in git.
# See docs/NOTIFY_TELEGRAM_SETUP.md.
TELEGRAM_CUSTOMER_BOT_TOKEN=                         # notify worker only (BotFather)
TELEGRAM_CUSTOMER_BOT_USERNAME=                      # public name; LEAVE EMPTY until the notify worker runs (empty hides the Settings panel)
NOTIFY_APP_ORIGIN=                                   # https://<the app>: the link back in a message
NOTIFY_TELEGRAM_API_BASE=                            # local runs only: http://127.0.0.1:8081 (tools/fake_telegram.py)

# ─── Brand channel poster, Telegram (migration 0108, docs/MARKETING_POSTS.md) ──
# OFF by default. Its own bot (never the operator's or the customer's token). Names only;
# values go in the poster's own env file (.env.marketing), never in git.
TELEGRAM_CHANNEL_BOT_TOKEN=                          # marketing worker only (a NEW bot from BotFather, admin of the channel)
MARKETING_TELEGRAM_CHAT=                             # @channelname or -100...; use a private test channel first
NIGHTSHIFT_MARKETING_POSTS=                          # `on` or nothing: anything but `on` and the worker does nothing

# ─── YouTube ───────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json      # download from Google Cloud Console
YOUTUBE_PRIVACY=private                             # private | unlisted | public
YOUTUBE_CHANNEL_ID=                                 # run `python main.py --list-channels` to find it

# ─── Intelligence layer (tools/run_intelligence_poll.py) ───
YOUTUBE_DATA_API_KEY=                               # separate API-key credential (not OAuth) for
                                                     # public-data reads — competitor/trend polling.
                                                     # Google Cloud Console → Credentials → API key.
COMPETITOR_CHANNEL_IDS=                             # comma-separated channel IDs to monitor, e.g.
                                                     # UCxxxxxxxx,UCyyyyyyyy — empty polls none.

# ─── TTS ───────────────────────────────────────────────────
TTS_PROVIDER=edge                                   # edge (free) | elevenlabs (premium)
EDGE_TTS_VOICE=en-US-ChristopherNeural
SCRIPT_LANGUAGE=English

# ─── Audio Mix ─────────────────────────────────────────────
MUSIC_VOLUME=0.08
SFX_VOLUME=0.5

# ─── Video ─────────────────────────────────────────────────
VIDEO_DURATION_TARGET=300

# ─── Performance ───────────────────────────────────────────
# BLAS/OpenMP thread cap. Keep at 1 on Windows — higher values make
# OpenBLAS fail with "Memory allocation still failed after 10 retries".
BLAS_THREADS=1

# ─── Cost rates (optional) ─────────────────────────────────
# USD per ONE unit — per token, per character, per second, per request, per byte.
# Leave a rate empty and the quantity is still recorded, but no dollar figure is
# claimed: the Command Center shows the cost as unknown rather than inventing a
# number. Set only the ones you have a real price for.
CHRONOS_PRICE_GEMINI_INPUT_TOKENS=
CHRONOS_PRICE_GEMINI_OUTPUT_TOKENS=
CHRONOS_PRICE_TTS_CHARACTERS=
CHRONOS_PRICE_RENDER_SECONDS=
CHRONOS_PRICE_PEXELS_REQUESTS=
CHRONOS_PRICE_UPLOAD_BYTES=

# ─── Opt-in AI providers & agent (all OFF unless set) ──────
# AI b-roll video provider. Default "minimax". To use another, set the
# provider AND the opt-in flag AND that provider's key.
CHRONOS_VIDEO_PROVIDER=minimax
CHRONOS_ENABLE_VIDEO_GEN=
MINIMAX_API_KEY=
CHRONOS_ENABLE_MINIMAX_BROLL=
HIGGSFIELD_API_KEY=
KLING_API_KEY=                                      # console API key (Bearer), or "access:secret"
KLING_ACCESS_KEY=                                   # or: access key + secret key → signed JWT
KLING_SECRET_KEY=
VEO_API_KEY=
SEEDANCE_API_KEY=                                   # BytePlus ModelArk (international) API key
WAN_API_KEY=                                        # Model Studio international key
WAN_WORKSPACE_ID=                                   # optional: use the workspace host, not the shared one
# AI images (bespoke stills). Default "pexels" stock.
CHRONOS_IMAGE_PROVIDER=pexels
CHRONOS_ENABLE_IMAGE_GEN=
LEONARDO_API_KEY=
# More image generators (CHRONOS_IMAGE_PROVIDER=flux|ideogram|fal; gpt-image
# uses OPENAI_API_KEY, nano-banana uses GEMINI_API_KEY). CHRONOS_IMAGE_MODEL
# overrides the selected provider's default model.
BFL_API_KEY=
IDEOGRAM_API_KEY=
FAL_KEY=
CHRONOS_IMAGE_MODEL=
# Extra LLM key (Gemini above stays the default scripter).
OPENAI_API_KEY=
# vidIQ research/scoring (advisory only).
VIDIQ_ACCESS_TOKEN=
CHRONOS_ENABLE_VIDIQ=
# Autopilot: pick the day's topic from this channel's own trend signals.
CHRONOS_AGENT_AUTOPILOT=

# ─── YouTube in-site OAuth (Command Center) ────────────────
# Set these on the Command Center (Vercel) to enable one-click "Connect
# YouTube" on the Providers page. Create an OAuth 2.0 Client (Web application)
# in Google Cloud with the YouTube Data API enabled, and register the redirect
# URI  https://<your-command-center>/api/oauth/youtube/callback .
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
