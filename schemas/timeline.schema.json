{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.local/schemas/timeline.schema.json",
  "title": "Nightshift Creative OS timeline v1",
  "description": "A studio timeline (modules/timeline.py), rendered by the ffmpeg engine through modules/timeline_render.py. Assets are referenced by id only; a resolver turns ids into files and refuses any the caller may not use. The hand-written validator in modules/timeline.py is the twin of this schema and also checks what JSON Schema cannot: out_s > in_s, speed 0.5-2 (a clip lasts (out_s - in_s) / speed), end_s > start_s, unique ids, no overlapping clips on a track, at most one V track, at most 64 audio clips and 5000 clips in all, fades that fit inside their clip, no duck on a speech track, and a total length of at most 4 hours. tests/test_timeline.py keeps the two in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "width",
    "height",
    "fps",
    "tracks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "width": {
      "$ref": "#/$defs/side"
    },
    "height": {
      "$ref": "#/$defs/side"
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "tracks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/video_track"
          },
          {
            "$ref": "#/$defs/audio_track"
          },
          {
            "$ref": "#/$defs/text_track"
          }
        ]
      }
    },
    "captions": {
      "$ref": "#/$defs/captions"
    },
    "overlays": {
      "type": "array",
      "maxItems": 16,
      "description": "Pictures or videos laid over the composited picture (picture-in-picture, stickers, logos), drawn in list order (later on top), under the texts. They may overlap in time and do not lengthen the timeline. At most 16, at most 4 of them videos (checked against the files in modules/timeline.py resolve_assets). Absent or empty = none, and the render is the one a document without the field gets.",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 14400.0
    },
    "side": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096,
      "multipleOf": 2
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "video_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "clips"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "V"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "clips": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/video_clip"
          }
        }
      }
    },
    "audio_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "clips"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "A"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "clips": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/audio_clip"
          }
        },
        "role": {
          "enum": [
            "music",
            "speech"
          ],
          "description": "What the track carries. A speech track is what a ducked music track is lowered under; a track with no role is treated as music."
        },
        "duck": {
          "$ref": "#/$defs/duck"
        }
      }
    },
    "text_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "clips"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "T"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "clips": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/text_clip"
          }
        }
      }
    },
    "video_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "start_s",
        "in_s",
        "out_s"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "start_s": {
          "$ref": "#/$defs/seconds",
          "description": "Where the clip starts on the timeline."
        },
        "in_s": {
          "$ref": "#/$defs/seconds",
          "description": "Source time the clip starts from (trim in). Ignored for a still image."
        },
        "out_s": {
          "$ref": "#/$defs/seconds",
          "description": "Source time the clip ends at (trim out); must be greater than in_s. The clip lasts (out_s - in_s) / speed on the timeline."
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "blur"
          ],
          "default": "contain",
          "description": "contain = letter/pillar-box, cover = fill and crop. blur = the whole picture over a blurred, enlarged copy of itself instead of black bars (video clips only)."
        },
        "fade_in_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "fade_out_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0,
          "default": 1,
          "description": "Playback speed. in_s/out_s stay source times; the clip lasts (out_s - in_s) / speed. Its own sound (audio: true) keeps its pitch."
        },
        "audio": {
          "type": "boolean",
          "default": false,
          "description": "Play the video's own sound, trimmed and sped like the picture. Off by default so older documents render as before; a source with no sound is silent."
        },
        "grade": {
          "$ref": "#/$defs/grade",
          "description": "Per-clip colour grade (ffmpeg eq). Absent = no change, and the clip renders exactly as it did before colour existed."
        },
        "filter": {
          "enum": [
            "mono",
            "sepia",
            "vintage",
            "cinematic",
            "cool",
            "warm",
            "high-contrast"
          ],
          "description": "A colour look applied to the fitted picture (after grade, before the bars of a contain fit)."
        },
        "filter_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "How far toward the look; needs filter. 0 drops the look."
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Darkened edges; 0 = off."
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 30.0,
          "default": 0,
          "description": "Gaussian blur sigma in output pixels; 0 = off."
        },
        "sharpen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Unsharp mask; 0 = off."
        },
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Film grain (fixed seed, so a render repeats); 0 = off."
        },
        "flip_h": {
          "type": "boolean",
          "default": false,
          "description": "Mirror left-right (after rotate, on the source)."
        },
        "flip_v": {
          "type": "boolean",
          "default": false,
          "description": "Mirror top-bottom (after rotate, on the source)."
        },
        "rotate": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "default": 0,
          "description": "Degrees clockwise, on the source before it is fitted."
        },
        "move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "description": "Ken Burns style move: the window goes linearly from `from` on the clip's first frame to `to` on its last. A still with a move has this instead of its automatic slow zoom.",
          "properties": {
            "from": {
              "$ref": "#/$defs/move_point"
            },
            "to": {
              "$ref": "#/$defs/move_point"
            }
          }
        },
        "reverse": {
          "type": "boolean",
          "default": false,
          "description": "Play the source range in_s..out_s backwards (picture and the clip's own sound). The range is limited by memory: at most REVERSE_MAX_BYTES of frames at the document's frame size and rate. Video only."
        },
        "freeze": {
          "type": "boolean",
          "default": false,
          "description": "Hold the frame at in_s for the clip's whole length (out_s - in_s). No sound; speed must be 1; not with reverse. Video only."
        },
        "denoise": {
          "type": "boolean",
          "default": false,
          "description": "FFT noise reduction with noise tracking (afftdn) on the clip's own sound, before loudness and gain; clears a steady hiss below about -35 dB and mostly leaves louder noise alone."
        },
        "loudnorm": {
          "type": "boolean",
          "default": false,
          "description": "Single-pass loudness normalisation (loudnorm: -16 LUFS, true peak -1.5 dB, range 11 LU) after denoise, before gain. Approximate on a very short clip."
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "description": "Keep a rectangle of the source picture, as fractions of it, after rotate/flip and before the fit. x + w and y + h must not go past 1.",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "w": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1,
              "default": 1
            },
            "h": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1,
              "default": 1
            }
          }
        },
        "angle": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0,
          "default": 0,
          "description": "Degrees clockwise: turns the FITTED picture about its centre inside the frame; what leaves the frame is cut, what is uncovered is black. 0 = none."
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brightness",
        "contrast",
        "saturation"
      ],
      "properties": {
        "brightness": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "default": 0,
          "description": "Added to the luma (eq brightness): -1 black .. 1 white, 0 = no change."
        },
        "contrast": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 1,
          "description": "Luma contrast around mid-grey (eq contrast): 0 flat grey .. 2 double, 1 = no change."
        },
        "saturation": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 3.0,
          "default": 1,
          "description": "Chroma gain (eq saturation): 0 monochrome .. 3, 1 = no change."
        }
      }
    },
    "audio_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "start_s",
        "in_s",
        "out_s"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "start_s": {
          "$ref": "#/$defs/seconds",
          "description": "Where the clip starts on the timeline."
        },
        "in_s": {
          "$ref": "#/$defs/seconds",
          "description": "Source time the clip starts from (trim in). Ignored for a still image."
        },
        "out_s": {
          "$ref": "#/$defs/seconds",
          "description": "Source time the clip ends at (trim out); must be greater than in_s. The clip lasts out_s - in_s."
        },
        "gain_db": {
          "type": "number",
          "minimum": -60.0,
          "maximum": 12.0,
          "default": 0
        },
        "fade_in_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "fade_out_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "denoise": {
          "type": "boolean",
          "default": false,
          "description": "FFT noise reduction with noise tracking (afftdn) on the clip's own sound, before loudness and gain; clears a steady hiss below about -35 dB and mostly leaves louder noise alone."
        },
        "loudnorm": {
          "type": "boolean",
          "default": false,
          "description": "Single-pass loudness normalisation (loudnorm: -16 LUFS, true peak -1.5 dB, range 11 LU) after denoise, before gain. Approximate on a very short clip."
        }
      }
    },
    "text_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_s",
        "end_s",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_s": {
          "$ref": "#/$defs/seconds"
        },
        "end_s": {
          "$ref": "#/$defs/seconds"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "font": {
          "enum": [
            "DejaVu Sans",
            "DejaVu Serif",
            "Liberation Sans",
            "Liberation Serif"
          ],
          "default": "DejaVu Sans"
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512,
          "default": 64
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#FFFFFF"
        },
        "outline_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#000000"
        },
        "outline_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 20.0,
          "default": 3.0
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "Fraction of the frame width where the anchor point sits."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "Fraction of the frame height where the anchor point sits."
        },
        "anchor": {
          "enum": [
            "top-left",
            "top",
            "top-right",
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right"
          ],
          "default": "center"
        },
        "fade_in_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "fade_out_s": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 20.0,
          "default": 0,
          "description": "A soft black drop shadow, in output pixels (down and to the right). 0 = none."
        },
        "box_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "A box of this colour behind the text, instead of its outline."
        },
        "box_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "Opacity of the box; needs box_color."
        },
        "anim_in": {
          "enum": [
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "pop",
            "typewriter"
          ],
          "description": "Entrance animation. fade/slide-*/pop also fade the alpha in; slides are named by the direction the item moves; typewriter writes a text letter by letter (text only). Not with fade_in_s."
        },
        "anim_out": {
          "enum": [
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "pop"
          ],
          "description": "Exit animation. Not with fade_out_s."
        },
        "anim_in_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.4,
          "description": "Length of the entrance; needs anim_in."
        },
        "anim_out_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.4,
          "description": "Length of the exit; needs anim_out. In + out never exceed the time the item is shown."
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "duration_s"
      ],
      "description": "Transition INTO this clip. dip_to_black fades the previous (touching) clip out and this one in over duration_s/2 each; no clip moves. crossfade dissolves the previous clip into this one: this clip starts exactly duration_s (0.2-2) before the previous one ends, the overlap is the dissolve, and duration_s may not be longer than either clip (validated in modules/timeline.py).",
      "properties": {
        "type": {
          "enum": [
            "cut",
            "dip_to_black",
            "crossfade"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "style": {
          "enum": [
            "fade",
            "dissolve",
            "fadeblack",
            "fadewhite",
            "wipeleft",
            "wiperight",
            "slideleft",
            "slideright",
            "slideup",
            "slidedown",
            "circleopen",
            "circleclose",
            "radial",
            "zoomin",
            "wipeup",
            "wipedown",
            "smoothleft",
            "smoothright",
            "smoothup",
            "smoothdown",
            "vertopen",
            "vertclose",
            "horzopen",
            "horzclose",
            "diagtl",
            "diagtr",
            "diagbl",
            "diagbr",
            "wipetl",
            "wipetr",
            "wipebl",
            "wipebr",
            "squeezeh",
            "squeezev",
            "pixelize",
            "hblur",
            "distance"
          ],
          "default": "fade",
          "description": "How a crossfade blends the two pictures: an ffmpeg xfade transition from this closed list. Only valid with type crossfade; fade (the default) is the plain dissolve and is dropped by normalise."
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cues"
      ],
      "properties": {
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "font": {
              "enum": [
                "DejaVu Sans",
                "DejaVu Serif",
                "Liberation Sans",
                "Liberation Serif"
              ],
              "default": "DejaVu Sans"
            },
            "size": {
              "type": "integer",
              "minimum": 8,
              "maximum": 512,
              "default": 56
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#FFFFFF"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "default": "#000000"
            },
            "outline_width": {
              "type": "number",
              "minimum": 0,
              "maximum": 20.0,
              "default": 3.0
            },
            "bold": {
              "type": "boolean",
              "default": true
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.9,
              "description": "Fraction of the frame height where the style's anchor sits (the bottom of a bottom-anchored caption)."
            },
            "preset": {
              "enum": [
                "karaoke",
                "pop_in",
                "boxed",
                "big_centre",
                "lower_third",
                "outlined",
                "neon",
                "typewriter",
                "line_slide",
                "clean"
              ],
              "description": "A ready-made animated caption style from this closed list; the export draws it with libass tags (modules/caption_styles.py, modules/ass_captions.py). Absent = the plain caption every older document has. A style supplies the font, size, colours and position the document leaves out."
            },
            "highlight_color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "The second colour an animated style draws: the lit word, the box, the glow or the outline. Ignored without a preset."
            }
          }
        },
        "cues": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/cue"
          }
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_s",
        "end_s",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_s": {
          "$ref": "#/$defs/seconds"
        },
        "end_s": {
          "$ref": "#/$defs/seconds"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "duck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_db"
      ],
      "description": "Lower this track while speech plays: by amount_db, reaching it attack_s before speech starts and coming back over release_s after it ends. Speech is every A track with role 'speech' and every video clip that plays its own sound. Not allowed on a speech track (validated in modules/timeline.py).",
      "properties": {
        "amount_db": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 40.0
        },
        "attack_s": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2.0,
          "default": 0.3
        },
        "release_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5.0,
          "default": 0.8
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "start_s",
        "end_s"
      ],
      "description": "A picture or video over the picture from start_s to end_s. (x, y) is where its CENTRE sits and w its width, as fractions of the frame; its height follows the file's own aspect ratio. A picture keeps its own transparency; a video plays from its first frame, silent, and must be at least as long as the span. end_s > start_s and at least one frame are checked in modules/timeline.py.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "start_s": {
          "$ref": "#/$defs/seconds"
        },
        "end_s": {
          "$ref": "#/$defs/seconds"
        },
        "x": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5,
          "description": "Centre, as a fraction of the frame width."
        },
        "y": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5,
          "description": "Centre, as a fraction of the frame height."
        },
        "w": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0,
          "default": 0.3,
          "description": "Width, as a fraction of the frame width."
        },
        "opacity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0,
          "description": "0 = invisible (renders nothing), 1 = opaque."
        },
        "anim_in": {
          "enum": [
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "pop"
          ],
          "description": "Entrance animation. fade/slide-*/pop also fade the alpha in; slides are named by the direction the item moves; typewriter writes a text letter by letter (text only)."
        },
        "anim_out": {
          "enum": [
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "pop"
          ],
          "description": "Exit animation."
        },
        "anim_in_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.4,
          "description": "Length of the entrance; needs anim_in."
        },
        "anim_out_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.4,
          "description": "Length of the exit; needs anim_out. In + out never exceed the time the item is shown."
        },
        "move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to"
          ],
          "description": "Two-keyframe move: the overlay's own x, y, w and opacity at start_s go linearly to these at end_s. A move to or from opacity 0 is a cheap fade; any other opacity change is slower to render.",
          "properties": {
            "to": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "w": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 1.0
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "chroma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color"
          ],
          "description": "Chroma key: pixels near `color` become transparent (ffmpeg chromakey), before the overlay is scaled; opacity and animations apply to what is left.",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "similarity": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.6,
              "default": 0.15,
              "description": "How far from the colour still counts as it."
            },
            "blend": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1,
              "description": "How softly the edge fades."
            }
          }
        }
      }
    },
    "move_point": {
      "type": "object",
      "additionalProperties": false,
      "description": "A window onto the fitted picture: zoom (1 = all of it) and its centre as fractions of the picture. Missing keys take 1 / 0.5 / 0.5; the centre is held where the window stays inside.",
      "properties": {
        "zoom": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 4.0,
          "default": 1.0
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    }
  }
}
