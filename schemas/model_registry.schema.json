{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.ai/schemas/model_registry.schema.json",
  "title": "Nightshift model registry",
  "description": "One entry per generative model the Creative OS can route to. modules/model_registry.py validates the registry against THIS file (a small in-repo JSON Schema evaluator; the worker image ships no jsonschema package) and then applies the cross-field rules a schema cannot express. Availability and verification are NOT here: they live in the database (migration 0035).",
  "type": "object",
  "required": ["version", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "note": {"type": "string"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "capability": {"enum": ["t2i", "edit", "t2v", "i2v", "tts", "sfx", "upscale", "remove_bg", "voice_change", "dub", "video_upscale", "describe", "captions", "expand", "relight", "erase", "video_edit", "video_reframe", "video_remove_bg", "music", "video_music", "video_character_swap"]},
    "relight_look": {"enum": ["soft", "warm", "cool", "golden_hour", "dramatic", "studio"]},
    "upscale_target": {"enum": ["720p", "1k", "2k", "4k"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "aspect": {"type": "string", "pattern": "^[0-9]{1,2}:[0-9]{1,2}$"},
    "resolution": {"type": "string", "pattern": "^([0-9]{3,4}p|[24]k)$"},
    "image_size": {"enum": ["512", "1K", "2K", "4K"]},
    "image_quality": {"enum": ["low", "medium", "high"]},
    "usd": {"type": ["number", "null"], "minimum": 0},
    "https_url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300},
    "model": {
      "type": "object",
      "required": ["id", "display_name", "provider", "adapter", "vendor_model", "capabilities", "output",
                   "inputs", "aspect_ratios", "resolutions", "durations_s", "audio_out", "async",
                   "api_documented", "pricing", "credit_unit", "entitlement", "terms_gate", "terms_notes",
                   "attribution", "api_exposure", "limits", "quality_tier", "speed_tier", "probe"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "provider": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
        "adapter": {"type": "string", "pattern": "^(image|video|audio)\\.[a-z0-9_]+$"},
        "vendor_model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "vendor_model_by_capability": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/capability"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        },
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "output": {"enum": ["image", "video", "audio", "text"]},
        "inputs": {
          "type": "object",
          "required": ["image_refs_max"],
          "additionalProperties": false,
          "properties": {
            "image_refs_max": {"type": "integer", "minimum": 0, "maximum": 30},
            "prompt_required": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
            "ref_capabilities": {
              "description": "The capabilities on which the adapter sends reference pictures (its reference_capabilities, narrowed to the model's own capabilities). Required on every image model; modules/model_registry.py checks it against the adapter. Migration 0235's film_price refuses a key frame with references unless this lists t2i, the path a film's key frame takes.",
              "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}
            }
          }
        },
        "aspect_ratios": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/aspect"}},
        "aspect_ratios_by_capability": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/capability"},
          "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/aspect"}}
        },
        "image_sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/image_size"}},
        "qualities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/image_quality"}},
        "resolutions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resolution"}},
        "default_resolution": {"$ref": "#/$defs/resolution"},
        "durations_s": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 120}},
        "upscale_factors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [2, 4]}},
        "languages": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/language"}},
        "upscale_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/upscale_target"}},
        "end_frame": {"type": "boolean"},
        "takes_negative_prompt": {
          "description": "The adapter puts negative_prompt in the vendor's request (migration 0218 refuses one, before any hold, for every model that does not say true; modules/model_registry.py checks it against the adapter's TAKES_NEGATIVE_PROMPT). Absent = false.",
          "type": "boolean"
        },
        "relight_looks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relight_look"}},
        "character_swap": {
          "description": "The vendor's own input limits for a video_character_swap entry (migration 0137, docs/CHARACTER_STUDIO.md). The worker refuses an input outside them before any paid call; the database refuses a length outside input_seconds when it quotes.",
          "type": "object",
          "required": ["input_seconds", "reference_images_max", "keeps_original_audio", "duration_follows_input", "mask_source",
                       "real_people", "billing", "input_max_bytes", "input_fps", "input_min_side_px", "input_max_side_px", "input_max_pixels",
                       "input_min_pixels"],
          "additionalProperties": false,
          "properties": {
            "input_seconds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 120}},
            "reference_images_max": {"type": "integer", "minimum": 1, "maximum": 30},
            "keeps_original_audio": {"type": "boolean"},
            "duration_follows_input": {"type": "boolean"},
            "mask_source": {"enum": ["none", "vendor_points", "caller_mask"]},
            "real_people": {"enum": ["consent_declared", "own_generated_clip_only"]},
            "billing": {"enum": ["output_x2", "input_plus_output"]},
            "input_max_bytes": {"type": "integer", "minimum": 1},
            "input_fps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 240}},
            "input_min_side_px": {"type": "integer", "minimum": 1},
            "input_max_side_px": {"type": "integer", "minimum": 1},
            "input_min_pixels": {"type": "integer", "minimum": 1},
            "input_max_pixels": {"type": "integer", "minimum": 1}
          }
        },
        "audio_out": {"type": "boolean"},
        "async": {"type": "boolean"},
        "api_documented": {
          "type": "object",
          "required": ["url", "checked_at", "source", "evidence"],
          "additionalProperties": false,
          "properties": {
            "url": {"$ref": "#/$defs/https_url"},
            "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "source": {"enum": ["vendor_sdk", "vendor_docs_search", "third_party"]},
            "evidence": {"type": "string", "minLength": 10, "maxLength": 400},
            "note": {"type": "string", "maxLength": 300}
          }
        },
        "pricing": {
          "type": "object",
          "required": ["unit", "provider_usd_per_unit", "source_url", "as_of", "confirmed"],
          "additionalProperties": false,
          "properties": {
            "unit": {"enum": ["image", "second", "character", "request"]},
            "provider_usd_per_unit": {"$ref": "#/$defs/usd"},
            "source_url": {"type": ["string", "null"], "pattern": "^https://"},
            "as_of": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "confirmed": {"type": "boolean"},
            "note": {"type": "string", "maxLength": 300},
            "changes": {
              "description": "A vendor price change the vendor has ANNOUNCED with a date (never a guess). effective_at is the moment in UTC; rates names each billed rate the change moves, from and to in USD. tests/test_dated_vendor_prices.py fails until docs/MIGRATIONS.md documents the credit_price_schedule row (migration 0224) for each of the model's credit units at that moment, scaled by at least the largest to/from ratio.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["effective_at", "rates", "source_url", "as_of", "evidence"],
                "additionalProperties": false,
                "properties": {
                  "effective_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
                  "rates": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
                    "additionalProperties": {
                      "type": "object",
                      "required": ["from", "to"],
                      "additionalProperties": false,
                      "properties": {"from": {"type": "number", "minimum": 0}, "to": {"type": "number", "minimum": 0}}
                    }
                  },
                  "source_url": {"type": "string", "pattern": "^https://"},
                  "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "evidence": {"type": "string", "minLength": 1, "maxLength": 300}
                }
              }
            },
            "variants": {
              "type": "object",
              "required": ["by", "prices"],
              "additionalProperties": false,
              "properties": {
                "by": {"enum": ["resolution", "image_size", "upscale_target", "quality", "audio", "resolution_audio"]},
                "prices": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/usd"}}
              }
            }
          }
        },
        "shutdown": {
          "description": "A shutdown the vendor has ANNOUNCED for the vendor model (never a guess). `on` is the date the vendor lists, which for Google is the EARLIEST possible one: from that day sellable_models (migration 0125) stops offering the model and creative_price stops quoting it. A model with no announced date has no `shutdown`; a replacement the vendor names without a date goes in api_documented.note.",
          "type": "object",
          "required": ["on", "source_url", "as_of"],
          "additionalProperties": false,
          "properties": {
            "on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "source_url": {"$ref": "#/$defs/https_url"},
            "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "replacement": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        },
        "blocked_countries": {
          "description": "Countries where the vendor forbids this model, as ISO 3166-1 alpha-2 codes (docs/GEO_BLOCK.md). The Command Center neither offers, quotes nor starts the model for a request whose address it reads in one of them; an unknown country is allowed and logged. Needs api_exposure web_only. command-center/lib/geo/blocked.ts carries the same lists (a test compares them).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "available_countries": {
          "description": "For a vendor whose terms are an ALLOW-list (Google: use only 'within an available region'), the vendor's own list, as ISO 3166-1 alpha-2 codes plus XK (docs/GEO_BLOCK.md). blocked_countries stays its complement in ISO; this list is what the database's country gate (migration 0230) asks, so a code on neither list (a placeholder such as EU, or no country at all) is refused as unverified instead of allowed. Needs blocked_countries and shares no code with it; every google row carries it. command-center/lib/geo/blocked.ts GOOGLE_AVAILABLE_REGIONS is the same list (a test compares them).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "requires_acknowledgement": {
          "description": "The rights acknowledgement kinds a job of this model needs for each input it is given (migration 0174, docs/RIGHTS_ACKNOWLEDGEMENT.md): likeness_photo (a real person's face in an uploaded image or video), voice_clone (a real person's voice), third_party_content (copyrighted material the person owns or licensed). The database refuses the job (acknowledgement_required) until the person acknowledged each input at the current text version. Absent or empty: nothing is asked.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {"enum": ["likeness_photo", "voice_clone", "third_party_content"]}
        },
        "operator_preview": {
          "description": "true lets the platform operator use this model in the operator's own credits-exempt organization while it is still hidden (migration 0139): a platform admin only, never a customer, never through the API. The model must still be verified by a real probe, and a terms gate or a missing credit price does not block the preview (an unpriced preview is recorded at the vendor cost in pricing.provider_usd_per_unit and charged to nobody). Absent or false: nothing changes.",
          "type": "boolean"
        },
        "credit_unit": {"type": "string", "pattern": "^model_[a-z0-9_]{1,40}_(image|second|character|request)$", "maxLength": 63},
        "entitlement": {
          "type": ["string", "null"],
          "pattern": "^models_(image|video|audio):(basic|premium|ultra)$"
        },
        "terms_gate": {
          "enum": [null, "written_consent_required", "terms_review_required", "plan_required:scale"]
        },
        "terms_notes": {"type": "array", "items": {"type": "string", "minLength": 10, "maxLength": 300}},
        "attribution": {
          "type": ["object", "null"],
          "required": ["text", "url"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 60},
            "url": {"$ref": "#/$defs/https_url"}
          }
        },
        "api_exposure": {"enum": ["any", "web_only", "web_mcp"]},
        "mcp_oauth_exposure": {
          "description": "true offers this model to an AI assistant the end user connected to their own workspace with OAuth (the MCP Studio tools, migration 0191): the same person generating with their own credits through their own assistant. Separate from api_exposure, which is about a developer's own code. Absent or false: not offered (the default for every model). Set true only in a reviewed change that cites the vendor's terms allowing exactly this use; tests/test_mcp_oauth_creative_migration.py lists the models that may carry it. Cannot be combined with blocked_countries (an assistant's request carries no address) or a rights acknowledgement (given in the Studio only).",
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "required": ["max_prompt_chars", "max_concurrent_per_org"],
          "additionalProperties": false,
          "properties": {
            "max_prompt_chars": {"type": "integer", "minimum": 1, "maximum": 100000},
            "max_concurrent_per_org": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_source_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
            "max_negative_prompt_chars": {"type": "integer", "minimum": 1, "maximum": 100000}
          }
        },
        "quality_tier": {"type": "integer", "minimum": 1, "maximum": 5},
        "speed_tier": {"type": "integer", "minimum": 1, "maximum": 5},
        "requires_adult": {"type": "boolean", "description": "The vendor's terms are 18+ (e.g. the Gemini API terms): sold only to an account with an adult attestation (requires_adult, migration 0192). Absent = false."},
        "probe": {
          "type": "object",
          "required": ["capability", "prompt"],
          "additionalProperties": false,
          "properties": {
            "capability": {"$ref": "#/$defs/capability"},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 200},
            "aspect_ratio": {"$ref": "#/$defs/aspect"},
            "resolution": {"$ref": "#/$defs/resolution"},
            "image_size": {"$ref": "#/$defs/image_size"},
            "quality": {"$ref": "#/$defs/image_quality"},
            "duration_s": {"type": "integer", "minimum": 1},
            "input_image": {"enum": ["generated"]},
            "input_audio": {"enum": ["speech"]},
            "target_language": {"$ref": "#/$defs/language"},
            "factor": {"enum": [2, 4]},
            "input_video": {"enum": ["generated"]},
            "end_frame": {"enum": ["generated"]},
            "upscale_target": {"$ref": "#/$defs/upscale_target"},
            "look": {"$ref": "#/$defs/relight_look"}
          }
        }
      }
    }
  }
}
