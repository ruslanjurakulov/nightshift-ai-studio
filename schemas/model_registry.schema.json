{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.ai/schemas/model_registry.schema.json",
  "title": "Nightshift model registry",
  "description": "One entry per generative model the Creative OS can route to. modules/model_registry.py validates the registry against THIS file (a small in-repo JSON Schema evaluator; the worker image ships no jsonschema package) and then applies the cross-field rules a schema cannot express. Availability and verification are NOT here: they live in the database (migration 0035).",
  "type": "object",
  "required": ["version", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "note": {"type": "string"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "capability": {"enum": ["t2i", "edit", "t2v", "i2v", "tts", "sfx"]},
    "aspect": {"type": "string", "pattern": "^[0-9]{1,2}:[0-9]{1,2}$"},
    "resolution": {"type": "string", "pattern": "^([0-9]{3,4}p|4k)$"},
    "image_size": {"enum": ["512", "1K", "2K", "4K"]},
    "usd": {"type": ["number", "null"], "minimum": 0},
    "https_url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300},
    "model": {
      "type": "object",
      "required": ["id", "display_name", "provider", "adapter", "vendor_model", "capabilities", "output",
                   "inputs", "aspect_ratios", "resolutions", "durations_s", "audio_out", "async",
                   "api_documented", "pricing", "credit_unit", "entitlement", "terms_gate", "terms_notes",
                   "attribution", "api_exposure", "limits", "quality_tier", "speed_tier", "probe"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "provider": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
        "adapter": {"type": "string", "pattern": "^(image|video|audio)\\.[a-z0-9_]+$"},
        "vendor_model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "vendor_model_by_capability": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/capability"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        },
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "output": {"enum": ["image", "video", "audio"]},
        "inputs": {
          "type": "object",
          "required": ["image_refs_max"],
          "additionalProperties": false,
          "properties": {"image_refs_max": {"type": "integer", "minimum": 0, "maximum": 16}}
        },
        "aspect_ratios": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/aspect"}},
        "aspect_ratios_by_capability": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/capability"},
          "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/aspect"}}
        },
        "image_sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/image_size"}},
        "resolutions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resolution"}},
        "durations_s": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 120}},
        "audio_out": {"type": "boolean"},
        "async": {"type": "boolean"},
        "api_documented": {
          "type": "object",
          "required": ["url", "checked_at", "source", "evidence"],
          "additionalProperties": false,
          "properties": {
            "url": {"$ref": "#/$defs/https_url"},
            "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "source": {"enum": ["vendor_sdk", "vendor_docs_search", "third_party"]},
            "evidence": {"type": "string", "minLength": 10, "maxLength": 400},
            "note": {"type": "string", "maxLength": 300}
          }
        },
        "pricing": {
          "type": "object",
          "required": ["unit", "provider_usd_per_unit", "source_url", "as_of", "confirmed"],
          "additionalProperties": false,
          "properties": {
            "unit": {"enum": ["image", "second", "character", "request"]},
            "provider_usd_per_unit": {"$ref": "#/$defs/usd"},
            "source_url": {"type": ["string", "null"], "pattern": "^https://"},
            "as_of": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "confirmed": {"type": "boolean"},
            "note": {"type": "string", "maxLength": 300},
            "variants": {
              "type": "object",
              "required": ["by", "prices"],
              "additionalProperties": false,
              "properties": {
                "by": {"enum": ["resolution", "image_size"]},
                "prices": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/usd"}}
              }
            }
          }
        },
        "credit_unit": {"type": "string", "pattern": "^model_[a-z0-9_]{1,40}_(image|second|character|request)$", "maxLength": 63},
        "entitlement": {
          "type": ["string", "null"],
          "pattern": "^models_(image|video|audio):(basic|premium|ultra)$"
        },
        "terms_gate": {
          "enum": [null, "written_consent_required", "terms_review_required", "plan_required:scale"]
        },
        "terms_notes": {"type": "array", "items": {"type": "string", "minLength": 10, "maxLength": 300}},
        "attribution": {
          "type": ["object", "null"],
          "required": ["text", "url"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 60},
            "url": {"$ref": "#/$defs/https_url"}
          }
        },
        "api_exposure": {"enum": ["any", "web_only"]},
        "limits": {
          "type": "object",
          "required": ["max_prompt_chars", "max_concurrent_per_org"],
          "additionalProperties": false,
          "properties": {
            "max_prompt_chars": {"type": "integer", "minimum": 1, "maximum": 100000},
            "max_concurrent_per_org": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "quality_tier": {"type": "integer", "minimum": 1, "maximum": 5},
        "speed_tier": {"type": "integer", "minimum": 1, "maximum": 5},
        "probe": {
          "type": "object",
          "required": ["capability", "prompt"],
          "additionalProperties": false,
          "properties": {
            "capability": {"$ref": "#/$defs/capability"},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 200},
            "aspect_ratio": {"$ref": "#/$defs/aspect"},
            "resolution": {"$ref": "#/$defs/resolution"},
            "image_size": {"$ref": "#/$defs/image_size"},
            "duration_s": {"type": "integer", "minimum": 1},
            "input_image": {"enum": ["generated"]}
          }
        }
      }
    }
  }
}
