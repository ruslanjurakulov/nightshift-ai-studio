.env
# Blanket-ignore JSON: client_secret.json and youtube_token*.json carry
# credentials and must never be committed. Safe ones are re-included below.
*.json
!package.json
!samples/*.json
# The example channel config. It holds no credential by construction —
# credential_ref names a secret, it never carries one — and the docs point
# at it, so the blanket rule above was hiding a file that should ship.
!channels.example.json
# Command Center (Next.js app) config — no credentials, and Vercel needs the
# lockfile for reproducible `npm ci` builds.
!command-center/tsconfig.json
!command-center/package-lock.json
# Remotion video engine: TS config, lockfile (for `npm ci`) and the props
# fixtures used by its smoke render — none carries a credential.
!video-engine/tsconfig.json
!video-engine/package-lock.json
!video-engine/fixtures/*.json
# The bot's runtime directories, anchored to the repository root.
#
# Unanchored ("logs/") these match at ANY depth, and that silently swallowed
# command-center/app/(app)/logs/ and command-center/components/logs/ — the
# Logs screen was never committed and never deployed. A leading slash keeps
# the rule pointed at the bot's own output and off the app's source.
/output/
/logs/
/history/
# Resume ledgers carried between Actions runs (tools/run_state_cache.py).
/.run_state/
/.run_state.staging/
__pycache__/
*.pyc
*.pyo
.DS_Store

# Synthesized audio — regenerated on demand by tools/generate_assets.py.
# Commit real recordings as .mp3 instead; the loaders check mp3 before wav,
# so a committed .mp3 always overrides the generated fallback.
assets/sfx/*.wav
assets/music/*.wav
!schemas/*.json
